<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alvis.media.repository.DatasetMapper">
  <resultMap id="BaseResultMap" type="com.alvis.media.domain.Dataset">
    <id column="dataset_id" jdbcType="INTEGER" property="datasetId" />
    <result column="name" jdbcType="VARCHAR" property="name" />
    <result column="file_name" jdbcType="VARCHAR" property="fileName" />
    <result column="file_path" jdbcType="VARCHAR" property="filePath" />
    <result column="file_size" jdbcType="BIGINT" property="fileSize" />
    <result column="row_count" jdbcType="INTEGER" property="rowCount" />
    <result column="columns_desc" jdbcType="VARCHAR" property="columnsDesc" />
    <result column="remark" jdbcType="VARCHAR" property="remark" />
    <result column="uploader_id" jdbcType="INTEGER" property="uploaderId" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
  </resultMap>

  <sql id="Base_Column_List">
    dataset_id, name, file_name, file_path, file_size, row_count,
    columns_desc, remark, uploader_id, create_time
  </sql>

  <insert id="insertSelective" parameterType="com.alvis.media.domain.Dataset">
    <selectKey keyProperty="datasetId" order="AFTER" resultType="java.lang.Integer">
      SELECT LAST_INSERT_ID()
    </selectKey>
    insert into t_dataset
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="name != null">name,</if>
      <if test="fileName != null">file_name,</if>
      <if test="filePath != null">file_path,</if>
      <if test="fileSize != null">file_size,</if>
      <if test="rowCount != null">row_count,</if>
      <if test="columnsDesc != null">columns_desc,</if>
      <if test="remark != null">remark,</if>
      <if test="uploaderId != null">uploader_id,</if>
      <if test="createTime != null">create_time,</if>
    </trim>
    <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
      <if test="name != null">#{name,jdbcType=VARCHAR},</if>
      <if test="fileName != null">#{fileName,jdbcType=VARCHAR},</if>
      <if test="filePath != null">#{filePath,jdbcType=VARCHAR},</if>
      <if test="fileSize != null">#{fileSize,jdbcType=BIGINT},</if>
      <if test="rowCount != null">#{rowCount,jdbcType=INTEGER},</if>
      <if test="columnsDesc != null">#{columnsDesc,jdbcType=VARCHAR},</if>
      <if test="remark != null">#{remark,jdbcType=VARCHAR},</if>
      <if test="uploaderId != null">#{uploaderId,jdbcType=INTEGER},</if>
      <if test="createTime != null">#{createTime,jdbcType=TIMESTAMP},</if>
    </trim>
  </insert>

  <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" />
    from t_dataset
    where dataset_id = #{datasetId,jdbcType=INTEGER}
  </select>

  <select id="selectByFilePath" parameterType="java.lang.String" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" />
    from t_dataset
    where file_path = #{filePath,jdbcType=VARCHAR}
    limit 1
  </select>

  <select id="selectAll" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" />
    from t_dataset
    order by dataset_id desc
  </select>

  <update id="updateByPrimaryKeySelective" parameterType="com.alvis.media.domain.Dataset">
    update t_dataset
    <set>
      <if test="name != null">name = #{name,jdbcType=VARCHAR},</if>
      <if test="remark != null">remark = #{remark,jdbcType=VARCHAR},</if>
      <if test="rowCount != null">row_count = #{rowCount,jdbcType=INTEGER},</if>
    </set>
    where dataset_id = #{datasetId,jdbcType=INTEGER}
  </update>

  <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
    delete from t_dataset where dataset_id = #{datasetId,jdbcType=INTEGER}
  </delete>
</mapper>
